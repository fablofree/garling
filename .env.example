# ──────────────────────────────────────────────────────────────────────────────
# Garage A. Lingiah — Environment variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# .env is read by Docker Compose automatically.
# The PHP app reads the same variables via getenv().
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_IMAGE=your-dockerhub-username/garage-lingiah:latest
APP_DEBUG=false
APP_PORT=8080          # host port the web app is exposed on

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_DATABASE=garage_lingiah
DB_USERNAME=postgres
DB_PASSWORD=change_me_please   # ← change this before going to production
DB_PORT=5432           # internal postgres port (do not change unless you know why)
DB_EXPOSED_PORT=5433   # host port mapped to postgres (for pgAdmin / psql access)
                       # set to empty string to disable host exposure:
                       # DB_EXPOSED_PORT=
